{
  "name": "NetroIA - Gestion Erreurs Pro",
  "nodes": [
    {
      "id": "n-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        260,
        360
      ],
      "parameters": {}
    },
    {
      "id": "n-extract",
      "name": "Extraire Contexte",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        360
      ],
      "parameters": {
        "jsCode": "const e = $input.item.json;\nconst workflow_name  = e.workflow?.name || 'inconnu';\nconst workflow_id    = e.workflow?.id   || '';\nconst execution_id   = e.execution?.id  || '';\nconst last_node      = e.execution?.lastNodeExecuted || '';\nconst error_message  = e.execution?.error?.message || e.error?.message || 'erreur inconnue';\nconst timestamp      = new Date().toISOString();\nreturn [{ json: { workflow_name, workflow_id, execution_id, last_node, error_message, timestamp } }];"
      }
    },
    {
      "id": "n-fp",
      "name": "Calculer Fingerprint",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        360
      ],
      "parameters": {
        "jsCode": "const d = $input.item.json;\nconst empreinte = (d.workflow_id + '|' + d.last_node + '|' + d.error_message)\n  .toLowerCase().replace(/[0-9]+/g, '#').replace(/\\s+/g, ' ').trim().slice(0, 180);\nconst isCritique  = /500|fatal|crash|cannot read|undefined is not|permission|401|403|ECONNREFUSED|timeout/.test(d.error_message);\nconst isTechnique = /401|403|429|timeout|ECONN|ENOTFOUND|rate|credential|auth|token/.test(d.error_message);\nconst gravite   = isCritique ? 'P1' : 'P2';\nconst categorie = isTechnique ? 'TECHNIQUE' : 'METIER';\nreturn [{ json: { ...d, empreinte, gravite, categorie, occurrences: 1 } }];"
      }
    },
    {
      "id": "n-getall",
      "name": "Lire Erreurs",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        860,
        360
      ],
      "parameters": {
        "operation": "getAll",
        "dataTableId": {
          "__rl": true,
          "value": "aRZ1JedsE72lla1s",
          "mode": "list",
          "cachedResultName": "Erreur Interne N8N"
        }
      }
    },
    {
      "id": "n-detect",
      "name": "Detecter Doublon",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        360
      ],
      "parameters": {
        "jsCode": "const allRows = $input.all();\nconst fpData = $('Calculer Fingerprint').first().json;\nconst match = allRows.find(r => r.json.empreinte_erreur === fpData.empreinte);\nconst is_duplicate = !!match;\nconst existing_occurrences = match ? (match.json.occurrences || 1) : 0;\nreturn [{ json: { ...fpData, is_duplicate, existing_occurrences } }];"
      }
    },
    {
      "id": "n-if",
      "name": "Est Doublon",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1260,
        360
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.is_duplicate }}",
              "value2": true
            }
          ]
        },
        "options": {}
      }
    },
